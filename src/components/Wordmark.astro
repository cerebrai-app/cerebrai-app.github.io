---
interface Props {
  /** Heading level to render the wordmark as. */
  as?: 'h1' | 'h2' | 'span';
}

const { as: Tag = 'span' } = Astro.props;
---

<Tag class="wordmark" aria-label="Cerebr.AI">
  <span aria-hidden="true">Cerebr</span>
  <span class="accent" aria-hidden="true">
    .AI
  </span>
</Tag>

<style>
  .wordmark {
    display: inline-block;
    margin: 0;
    font-size: clamp(3rem, 13vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .accent {
    background: linear-gradient(120deg, var(--accent-a), var(--accent-b));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
