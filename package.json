    "verify": "pnpm run check && pnpm run lint && pnpm run format:check",
    "astro": "astro",
    "screenshot": "node scripts/screenshot.mjs screenshots"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/vue": "^7.1.2",
    "astro": "^7.4.8",
    "typescript": "^6.0.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.72.2"
  }
